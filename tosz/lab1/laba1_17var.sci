function result=lab1(n)
clc;

// Введення порядку матриці з клавіатури
//n = input("Введіть порядок матриці n: ");

// Вибір способу заповнення матриці A
choice = input("Бажаєте ввести матрицю A вручну (y/n)? ", "string");
select choice
    case 'y' then
        disp("Введіть елементи матриці A (розділяйте рядки знаком ;, а стовпці - пробілом або комою):");
        A = input("A = ");
    case 'n' then
        // Створення матриці A згідно з умовами завдання
        i = (1:n)' * ones(1, n); // Створення матриці індексів i
        j = ones(n, 1) * (1:n);  // Створення матриці індексів j

        A = 1 ./ (i + j - 1);    // Обчислення значень для всіх елементів
        A(i == j) = 0;           // Задання нулів на діагоналі
        A(i > j) = -A(i > j);    // Зміна знаку для елементів нижче діагоналі
    else
        disp("Невірний вибір. Програма завершена.");
        abort; // Завершення програми у разі помилки
end

// Вибір способу заповнення матриці B
choice = input("Бажаєте ввести матрицю B вручну (Y/N)? ", "string");
select choice
    case 'y' then
        disp("Введіть елементи матриці B (розділяйте рядки знаком ;, а стовпці - пробілом або комою):");
        B = input("B = ");
    case 'n' then
        // Створення матриці B з випадковими значеннями
        B = rand(n, n);
    else
        disp("Невірний вибір. Програма завершена.");
        abort; // Завершення програми у разі помилки
end

// Обчислення результату множення
result = A * B;

// Виведення результатів
disp("Матриця A:");
disp(A);
disp("Матриця B:");
disp(B);
disp("Результат множення A * B:");
disp(result);
endfunction
